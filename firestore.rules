rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn()

        && exists(/databases/$(database)/documents/users/$(request.auth.uid))

        // keep uppercase to match User.kt
        && 'ADMIN' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid);


      allow update: if (request.resource.data.roles == resource.data.roles && isSelf(uid)) || isAdmin();

      allow delete: if isSelf(uid) || isAdmin();
    }

    match /campsites/{id} {
      allow read: if signedIn();


      allow create: if request.resource.data.ownerId == request.auth.uid && signedIn();

      allow update, delete: if signedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
      match /reviews/{reviewId} {
        allow read: if signedIn();
        allow create: if signedIn();
      }
    }

    match /lotteries/{id} {
      allow read: if signedIn();


      allow create: if request.resource.data.ownerId == request.auth.uid && signedIn();

      allow update, delete: if signedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
      match /entries/{entrantId} {
        allow read: if signedIn();
        allow create, delete: if isSelf(entrantId);
      }
    }

    match /reservations/{id} {
      allow read, create: if signedIn();
      allow update: if signedIn()
        && (resource.data.entrantId == request.auth.uid
            || resource.data.ownerId == request.auth.uid
            || isAdmin());
    }

    match /notifications/{id} {
      allow read: if (signedIn() && resource.data.toUserId == request.auth.uid) || isAdmin();


      allow create: if request.resource.data.fromUserId == request.auth.uid && signedIn();

      allow update: if signedIn() && resource.data.toUserId == request.auth.uid;
    }

    match /messages/{id} {
      allow read: if signedIn()
        && (resource.data.fromUserId == request.auth.uid
            || resource.data.toUserId == request.auth.uid
            || isAdmin());


      allow create: if request.resource.data.fromUserId == request.auth.uid && signedIn();
    }
  }
}
