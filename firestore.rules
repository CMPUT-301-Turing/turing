rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn()

        && exists(/databases/$(database)/documents/users/$(request.auth.uid))

        // keep uppercase to match User.kt
        && 'ADMIN' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }
    function hostingAllowed(uid) {
      return isSelf(uid) && !exists(/databases/$(database)/documents/ownerSuspensions/$(uid));
    }
    match /ownerSuspensions/{uid} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && !isSelf(uid)
        && request.resource.data.removedBy == request.auth.uid;
      allow delete: if isAdmin();
    }
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid)
        && request.resource.data.roles is list
        && request.resource.data.roles.hasOnly(['ENTRANT', 'OWNER'])
        && (!('OWNER' in request.resource.data.roles) || hostingAllowed(uid));


      allow update: if (request.resource.data.roles == resource.data.roles && isSelf(uid)) || isAdmin();

      allow delete: if isSelf(uid) || isAdmin();
    }

    match /campsites/{id} {
      allow read: if signedIn();


      allow create: if hostingAllowed(request.resource.data.ownerId);

      allow update, delete: if signedIn()
        && (hostingAllowed(resource.data.ownerId) || isAdmin());
      match /reviews/{reviewId} {
        allow read: if signedIn();
        allow create: if signedIn();
      }
    }

    match /lotteries/{id} {
      allow read: if signedIn();


      allow create: if hostingAllowed(request.resource.data.ownerId);

      allow update, delete: if signedIn()
        && (hostingAllowed(resource.data.ownerId) || isAdmin());
      match /entries/{entrantId} {
        allow read: if signedIn();
        allow create, delete: if isSelf(entrantId);
      }
    }

    match /reservations/{id} {
      allow read, create: if signedIn();
      allow update: if signedIn()
        && (resource.data.entrantId == request.auth.uid
            || hostingAllowed(resource.data.ownerId)
            || isAdmin())
        && (resource.data.status == request.resource.data.status
            || request.resource.data.status != 'REJECTED'
            || (resource.data.status == 'ACTIVE'
                && (hostingAllowed(resource.data.ownerId) || isAdmin())
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])));
    }

    match /notifications/{id} {
      allow read: if (signedIn() && resource.data.toUserId == request.auth.uid) || isAdmin();


      allow create: if request.resource.data.fromUserId == request.auth.uid && signedIn();

      allow update: if signedIn() && resource.data.toUserId == request.auth.uid;
    }

    match /messages/{id} {
      allow read: if signedIn()
        && (resource.data.fromUserId == request.auth.uid
            || resource.data.toUserId == request.auth.uid
            || isAdmin());


      allow create: if request.resource.data.fromUserId == request.auth.uid && signedIn();
    }
  }
}
