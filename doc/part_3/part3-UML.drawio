        <mxCell id="vm-note-0" parent="1" style="text;html=1;fontSize=14;align=left;strokeColor=none;" value="Notation: + public getter; {set: private/protected} explicitly records Kotlin setter visibility." vertex="1">
          <mxGeometry height="24" width="1580" x="40" y="1128" as="geometry" />
        </mxCell>
        <mxCell id="vm-note-1" parent="1" style="text;html=1;fontSize=14;align=left;strokeColor=none;" value="These setter annotations are explanatory labels, not standard UML property modifiers. {readOnly} is used for val." vertex="1">
          <mxGeometry height="24" width="1580" x="40" y="1153" as="geometry" />
        </mxCell>
        <mxCell id="vm-note-2" parent="1" style="text;html=1;fontSize=14;align=left;strokeColor=none;" value="BaseViewModel is abstract. Concrete ViewModels inherit its members; inherited members are not repeated here." vertex="1">
          <mxGeometry height="24" width="1580" x="40" y="1178" as="geometry" />
        </mxCell>
        <mxCell id="vm-note-3" parent="1" style="text;html=1;fontSize=14;align=left;strokeColor=none;" value="unreadCount is computed from notifications. Repository properties are constructor-injected vals." vertex="1">
          <mxGeometry height="24" width="1580" x="40" y="1203" as="geometry" />
        </mxCell>
        <mxCell id="vm-note-4" parent="1" style="text;html=1;fontSize=14;align=left;strokeColor=none;" value="launchCall itself is not suspend; its block parameter is a suspend function. No connections added yet." vertex="1">
          <mxGeometry height="24" width="1580" x="40" y="1228" as="geometry" />
        </mxCell>
